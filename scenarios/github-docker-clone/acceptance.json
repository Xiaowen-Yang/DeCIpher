{
  "checks": [
    {
      "id": "repo_cloned",
      "type": "command",
      "command": "test -d getting-started-app && echo exists",
      "expect_stdout_contains": "exists",
      "description": "Repository was cloned into workspace"
    },
    {
      "id": "readme_exists",
      "type": "command",
      "command": "test -f getting-started-app/README.md && echo found",
      "expect_stdout_contains": "found",
      "description": "README.md exists in cloned repo"
    },
    {
      "id": "dockerfile_exists",
      "type": "command",
      "command": "find . -name Dockerfile -type f | head -1 | grep -q Dockerfile && echo found",
      "expect_stdout_contains": "found",
      "description": "A Dockerfile exists (either from repo or generated)"
    },
    {
      "id": "image_built",
      "type": "command",
      "command": "docker images --format '{{.Repository}}' | grep -qi 'getting-started' && echo found",
      "expect_stdout_contains": "found",
      "timeout": 300000,
      "description": "Docker image was built successfully"
    },
    {
      "id": "container_runs",
      "type": "command",
      "command": "docker ps --format '{{.Image}}' | grep -qi 'getting-started' && echo running",
      "expect_stdout_contains": "running",
      "timeout": 30000,
      "description": "Container is currently running"
    }
  ]
}
