function fuzzyMatchCommands(prefix) {
  // Exact prefix match first
  const exact = SLASH_COMMANDS.filter(c => c.name.startsWith(prefix));
  if (exact.length > 0) return exact;
  // Fuzzy: match if all chars of prefix appear in order in the command name
  const chars = prefix.replace('/', '').toLowerCase();
  return SLASH_COMMANDS.filter(c => {
    const name = c.name.slice(1).toLowerCase();
    let ci = 0;
    for (let ni = 0; ni < name.length && ci < chars.length; ni++) {
      if (name[ni] === chars[ci]) ci++;
    }
    return ci === chars.length;
  });
}

function showSlashSuggestions(prefix = '/') {
  const matches = fuzzyMatchCommands(prefix);
  printSectionHeader('COMMANDS', 'command');
  if (matches.length === 0) {
    console.log(`  ${D('(no matching commands)')}`);
  } else {
    matches.forEach(command => {
      console.log(`  ${C(command.name.padEnd(14))} ${D(command.description)}`);
    });
  }
  console.log('');
}

function parseExecutionFlags(args = []) {
  return {
    keepRuntimeArtifacts: args.includes('--keep-container') || args.includes('--no-cleanup'),
  };
}

async function promptForConfigValue(rl, key) {
  if (key !== 'api_key') {
    return null;
  }

  rl.pause();
  const value = await askHiddenInput(`  ${D('API Key')} ${D('(input hidden)')}: `);
  rl.resume();
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
  }
  return value;
}

async function applyConfigUpdate(config, scope, key, rawValue, rl) {
  const normalizedKey = normalizeConfigKey(key);
  if (!canUpdateConfigKey(normalizedKey, scope)) {
    throw new Error(
      `Unsupported ${scope} setting '${key}'.`,
    );
  }

  let value = rawValue;
  if ((value == null || value === '') && normalizedKey === 'api_key') {
    value = await promptForConfigValue(rl, normalizedKey);
  }

  if (value == null || value === '') {
    throw new Error(`Missing value for ${normalizedKey}.`);
  }

  const coercedValue = coerceConfigValue(normalizedKey, value);
  const next = await writeConfig({ [normalizedKey]: coercedValue });
  const displayValue = normalizedKey === 'api_key'
    ? maskSecret(next.api_key)
    : coercedValue ?? '(default)';

  return {
    config: next,
    key: normalizedKey,
    displayValue,
  };
}

function completeSlashCommand(line) {
  if (!line.startsWith('/')) {
    // Path completion: if line contains path-like chars, complete file paths
    if (/[.\/~]/.test(line) || line.startsWith('scenarios')) {
      return completeFilePath(line);
    }
    return [[], line];
  }

  const matches = fuzzyMatchCommands(line);
  const hits = matches.map(c => c.name);
  return [hits.length ? hits : SLASH_COMMANDS.map(c => c.name), line];
}

function completeFilePath(partial) {
  try {
    const path = require('node:path');
    const fs = require('node:fs');
    const resolved = partial.startsWith('~')
      ? partial.replace('~', require('node:os').homedir())
      : partial;
    const dir = fs.statSync(resolved).isDirectory() ? resolved : path.dirname(resolved);
    const prefix = fs.statSync(resolved).isDirectory() ? '' : path.basename(resolved);
    const entries = fs.readdirSync(dir);
    const matches = entries
      .filter(e => e.startsWith(prefix))
      .map(e => {
        const full = path.join(dir === resolved ? partial : path.dirname(partial), e);
        const isDir = fs.statSync(path.join(dir, e)).isDirectory();
        return isDir ? full + '/' : full;
      });
    return [matches, partial];
  } catch {
    return [[], partial];
  }
}

function printSectionHeader(label, tone = 'agent') {
  const colorize = tone === 'input' ? BY : tone === 'command' ? Y : BC;
  console.log(`\n${D('┌')} ${colorize(label)} ${D('─'.repeat(Math.max(8, termWidth() - stripAnsi(label).length - 8)))}`);
}

function buildPromptFrame(mode = 'YOU') {
  const top = `${D('╭─')}`;
  const prompt = `${D('│')} ${mode === 'SEARCH' ? Y('SEARCH ›') : BY('❯')} `;
  const bottom = `${D('╰─')}`;
  return { top, prompt, bottom };
}

// ── Hidden input (API key) ─────────────────────────────────
/**
 * Read a line from stdin without echoing characters (for API keys).
 * Uses TTY raw mode when available; falls back to normal readline in
 * non-TTY environments (pipes, CI).
 */
function askHiddenInput(prompt) {
  return new Promise((resolve) => {
    process.stdout.write(prompt);

    if (process.stdin.isTTY) {
      // Raw mode: characters are not echoed
      let value = '';
      process.stdin.setRawMode(true);
      process.stdin.resume();
      process.stdin.setEncoding('utf8');

      const onData = (char) => {
        if (char === '\n' || char === '\r' || char === '\u0004') {
          process.stdin.setRawMode(false);
          process.stdin.pause();
          process.stdin.removeListener('data', onData);
          process.stdout.write('\n');
          resolve(value.trim());
        } else if (char === '\u0003') {
          process.exit(); // Ctrl-C
        } else if (char === '\u007f' || char === '\u0008') {
          value = value.slice(0, -1); // Backspace
        } else {
          value += char;
        }
      };

      process.stdin.on('data', onData);
    } else {
      // Non-TTY (pipe / CI): read normally — no echoing in non-interactive shells
      const linerl = createInterface({ input: process.stdin });
      linerl.once('line', (line) => {
        linerl.close();
        resolve(line.trim());
      });
    }
  });
}

// ── First-run setup ────────────────────────────────────────
async function firstRunSetup() {
  console.log(`\n  ${B('Welcome to DeCIpher')} — ${D('AI CI Troubleshooter')}\n`);
  console.log(`  ${Y('No API key configured.')} Let's set one up.\n`);

  const rl = createInterface({ input: process.stdin, output: process.stdout });
  const ask = (q) => new Promise(resolve => rl.question(q, resolve));

  const provider = (await ask(`  ${D('Provider')} [openai/anthropic/custom]: `)).trim() || 'openai';

  let base_url = null;
  if (provider === 'custom' || !['openai', 'anthropic'].includes(provider)) {
    base_url = (await ask(`  ${D('Base URL')}: `)).trim() || null;
  }

  const model = (await ask(`  ${D('Model')} [${provider === 'anthropic' ? 'claude-sonnet-4-20250514' : 'gpt-4o'}]: `)).trim() ||
    (provider === 'anthropic' ? 'claude-sonnet-4-20250514' : 'gpt-4o');

  rl.close(); // Close before reading secret

  // Ask for API key with hidden input (no echo)
  const api_key = await askHiddenInput(`  ${D('API Key')} ${D('(input hidden)')}: `);

  if (!api_key) {
    console.log(`\n  ${pc.red('No API key provided. Exiting setup.')}\n`);
    return null;
  }

  const updates = { provider: base_url ? 'custom' : provider, model, api_key };
  if (base_url) updates.base_url = base_url;

  const config = await writeConfig(updates);
  console.log(`\n  ${G('✓')} Config saved to ~/.decipher/config.json\n`);
  return config;
}

async function ensureApiKey() {
  const config = await readConfig();
  if (config.api_key) return config;
  return await firstRunSetup();
}

// ── Interactive conversation ───────────────────────────────
async function collectContext() {
  const { exec } = await import('node:child_process');
  const { promisify } = await import('node:util');
  const run = promisify(exec);

  const ctx = {};
  try { ctx.git_status = (await run('git status --short')).stdout.trim(); } catch { ctx.git_status = ''; }
  try { ctx.git_diff = (await run('git diff --name-only HEAD')).stdout.trim(); } catch { ctx.git_diff = ''; }
  try { ctx.dockerfiles = (await run("find . -name 'Dockerfile*' -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null")).stdout.trim(); } catch { ctx.dockerfiles = ''; }
  try { ctx.workflows = (await run("find . -path '*/.github/workflows/*.yml' -not -path '*/node_modules/*' 2>/dev/null")).stdout.trim(); } catch { ctx.workflows = ''; }

  return Object.entries(ctx)
    .filter(([, v]) => v)
    .map(([k, v]) => `### ${k}\n${v}`)
    .join('\n\n') || 'No additional context collected.';
}

// Conversation history for multi-turn interaction
const conversationHistory = [];
let projectContext = null;
let skillsContent = null;

async function loadSkills() {
  if (skillsContent) return skillsContent;
  const { readFile } = await import('node:fs/promises');
  const { join, dirname } = await import('node:path');
  const { fileURLToPath } = await import('node:url');
  const __dir = dirname(fileURLToPath(import.meta.url));
  const skillsDir = join(__dir, '..', 'skills');

  let skills = '';
  for (const name of ['ci-triage', 'docker-debug', 'env-bootstrap']) {
    try {
      skills += await readFile(join(skillsDir, name, 'SKILL.md'), 'utf8') + '\n\n';
    } catch { /* skip */ }
  }
  skillsContent = skills;
  return skills;
}

/**
 * Mission-first input handler — Codex Plan Mode style.
 *
 * Flow:
 *  1. Resolve a concrete target from the input (path detection, no LLM).
 *  2. Call the LLM to analyze intent and produce a plan (show spinner).
 *  3. Announce what was understood + the plan steps.
 *  4. If clarification needed → ask one focused question.
 *  5. Otherwise → one-time session approval → execute.
 *  6. No target + conversational input → fall back to chat mode.
 */
async function handleInteractiveInput(input, config, rl, sessionState) {
  const { resolveTarget, askApproval, executeTarget } =
    await import('../agents/executor/index.js');
  const { analyzeMission } = await import('../lib/mission-analyzer.js');
  const { startSpinner } = await import('../lib/spinner.js');

  // ── Step 1: Fast target resolution (no LLM) ──────────────
  let target = null;
  try {
    target = await resolveTarget(input);
  } catch { /* ignore resolution errors */ }

  // If no explicit path resolved but the user implies "here" / "this folder" /
  // "current directory", use cwd as the target. Don't force clarification when
  // the intent is clear.
  if (!target && /\b(this folder|this dir|here|current|当前|这个|这里)\b/i.test(input)) {
    const { resolvePathTarget } = await import('../agents/executor/index.js');
    target = await resolvePathTarget(process.cwd()).catch(() => null);
    if (!target) {
      target = { path: process.cwd(), type: 'directory' };
    }
  }

  sessionState.currentTarget = target ?? sessionState.currentTarget;

  // ── Step 2: LLM mission analysis ─────────────────────────
  // Always send the user's full input to the LLM — their words are the best
  // signal for intent. Don't replace with meta.prompt or strip to just a path.
  const meta = target?.meta ?? {};
  const isGreenfield = meta.start_state === 'empty' || meta.mission_type === 'greenfield'
    || target?.type === 'new_directory';

  const sp = startSpinner('Understanding mission');
  const analysis = await analyzeMission(input, target, config);

  // If the LLM returned a generic fallback ("Run DeCIpher on path"), use
  // the user's original input or the scenario prompt as the goal instead.
  let missionGoal;
  if (analysis.inferred) {
    // Fallback path — extract the natural language part from user input
    // by removing the path, or use the scenario prompt
    const pathPattern = target?.path ? new RegExp(target.path.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g') : null;
    const naturalText = pathPattern ? input.replace(pathPattern, '').replace(/["']/g, '').trim() : input;
    missionGoal = naturalText.length > 10 ? naturalText : (meta.prompt ?? analysis.understood_as);
  } else {
    missionGoal = analysis.understood_as;
  }
  sp.stop(missionGoal);

  sessionState.currentMission = {
    type: isGreenfield ? 'greenfield' : analysis.action,
    goal: missionGoal,
    domain: 'deployment',
    stop_boundary: meta.mission_stop_boundary ?? 'mission_complete',
    requires_clarification: analysis.requires_clarification,
    clarification_question: analysis.clarification_question,
  };

  await persistSessionSnapshot({
    target_path: target?.path ?? sessionState.currentTarget?.path ?? null,
    target_type: target?.type ?? sessionState.currentTarget?.type ?? null,
    mission: sessionState.currentMission,
    mission_summary: analysis.understood_as,
    analysis,
    approval_policy: sessionState.approvalPolicy ?? config.approval_policy ?? 'on-request',
    approved: sessionState.approved ?? false,
    last_verification_state: sessionState.lastVerificationResult ?? null,
    outcome: analysis.requires_clarification ? 'NEEDS_CLARIFICATION' : 'PENDING',
    resumable: true,
  });

  // ── Step 3: Announce understood mission + plan ────────────
  // For greenfield, use the planner to get proper plan steps
  const { createMissionPlan } = await import('../agents/planner/index.js');
  const plan = createMissionPlan(sessionState.currentMission);
  sessionState.currentPlan = plan;

  // Use plan steps if available, fall back to analysis steps
  const displaySteps = (plan.steps?.length > 0)
    ? plan.steps.map(s => s.label)
    : analysis.steps;

  printSectionHeader('MISSION', 'agent');
  console.log(`  ${BY('Understood:')} ${W(missionGoal)}`);
  if (target) {
    console.log(`  ${D('Target:')} ${C(target.path)} ${D(`(${target.type})`)}`);
  }
  if (displaySteps.length > 0) {
    console.log(`\n  ${D('Plan:')}`);
    displaySteps.forEach((step, i) => {
      console.log(`    ${D(`${i + 1}.`)} ${step}`);
    });
  }
  console.log('');

  // ── Step 4: Clarification gate ────────────────────────────
  // If the LLM understood the mission but no target was resolved, use cwd.
  // The LLM already decided the intent is clear — don't second-guess it
  // with a hardcoded clarification gate.
  if (!target && !analysis.requires_clarification) {
    target = { path: process.cwd(), type: 'directory' };
    sessionState.currentTarget = target;
  }

  if (analysis.requires_clarification) {
    printSectionHeader('CLARIFICATION NEEDED', 'command');
    console.log(`  ${BY('DeCIpher asks:')} ${W(analysis.clarification_question ?? 'What do you want DeCIpher to do exactly?')}`);
    console.log(`  ${D('Reply below and DeCIpher will continue from this mission context.')}\n`);
    return;
  }

  // ── Step 5: No target → conversational mode ───────────────
  if (!target) {
    await handleConversationalInput(input, config);
    return;
  }

  // ── Step 6: One-time approval + execution ─────────────────
  const approved = await askApproval(rl, sessionState);
  if (!approved) {
    await handleConversationalInput(input, config);
    return;
  }

  try {
    const result = await executeTarget(target, analysis.action, config, sessionState, { rl });
    if (result?.needs_clarification) {
      printSectionHeader('CLARIFICATION NEEDED', 'command');
      console.log(`  ${BY('AI asks:')} ${W(result.needs_clarification)}`);
      console.log(`  ${D('Please provide more information below to resume.')}\n`);
    }
  } catch (err) {
    console.log(`  ${pc.red('Executor error:')} ${err.message}\n`);
  }
}

/**
 * Conversational fallback for explicit questions and non-execution turns.
 * The default runtime remains mission-first; this path is now the exception.
 */
async function handleConversationalInput(input, config) {
  const { TAXONOMY } = await import('../agents/triage/index.js');

  // Collect project context once per session
  if (!projectContext) {
    projectContext = await collectContext();
  }
  const skills = await loadSkills();

  const systemPrompt = `You are DeCIpher, a mission-driven local engineering agent running in an interactive terminal session. You can operate as a general local agent, but your strongest specialty is CI, deployment, Docker, and environment workflows.

## Your personality
- Direct, concise, helpful — like a senior engineer pair-programming with the user
- Mission-first, not chatty
- If the user asks a question, answer it directly
- If the user is actually trying to get work done, steer them toward concrete execution inputs

## Your capabilities
- Understand local engineering missions and clarify missing requirements
- Classify CI/deployment failures into these categories: ${TAXONOMY.join(', ')}
- Analyze error logs, suggest root causes, and propose concrete fixes
- Suggest commands, generated files, and verification steps when execution is not happening directly

## Domain knowledge
${skills}

## Current project context
Directory: ${process.cwd()}
${projectContext}

## Response guidelines
- For greetings/casual input: respond naturally in 1-2 sentences
- For vague engineering requests: ask only the blocking question
- For clear engineering problems: give a direct diagnosis with:
  - What's wrong (1 sentence)
  - Why (brief root cause)
  - How to fix (specific commands or file changes)
  - How to verify (a command to run)
- Keep responses SHORT. No walls of text. Use bullet points for steps.
- Do NOT use the structured report format (**Classification:**, **Root Cause:**, etc.)
- Respond in the same language the user writes in (Chinese → Chinese, English → English)`;

  conversationHistory.push({ role: 'user', content: input });

  const messages = [
    { role: 'system', content: systemPrompt },
    ...conversationHistory,
  ];

  printSectionHeader('DECIPHER', 'agent');

  const { startSpinner } = await import('../lib/spinner.js');
  const sp = startSpinner('Thinking');
  try {
    const response = await callAIMultiTurn(messages, config);
    sp.stop('Response ready');

    conversationHistory.push({ role: 'assistant', content: response });

    if (conversationHistory.length > 20) {
      conversationHistory.splice(0, conversationHistory.length - 20);
    }

    const formatted = response
      .split('\n')
      .map(line => `  ${line}`)
      .join('\n');
    console.log(formatted);
    console.log('');
  } catch (err) {
    sp.stop();
    console.log(`  ${pc.red('Error:')} ${err.message}\n`);
  }
}

// Multi-turn AI call supporting message arrays
async function callAIMultiTurn(messages, config) {
  const { provider, api_key, model, base_url } = config;

  if (!api_key) {
    throw new Error('No API key configured. Run: decipher config set api-key <key>');
  }

  const url = base_url ?? (provider === 'anthropic'
    ? 'https://api.anthropic.com/v1/messages'
    : 'https://api.openai.com/v1/chat/completions');

  if (provider === 'anthropic' && !base_url) {
    // Anthropic format: extract system from messages
    const system = messages.find(m => m.role === 'system')?.content ?? '';
    const turns = messages.filter(m => m.role !== 'system');
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': api_key,
        'anthropic-version': '2023-06-01',
      },
      body: JSON.stringify({
        model: model ?? 'claude-sonnet-4-20250514',
        max_tokens: 1024,
        system,
        messages: turns,
      }),
    });
    if (!response.ok) {
      const error = await response.text();
      throw new Error(`Anthropic API error ${response.status}: ${error}`);
    }
    const data = await response.json();
    const text = data?.content?.[0]?.text;
    if (typeof text !== 'string') throw new Error(`Unexpected Anthropic response shape: ${JSON.stringify(data).slice(0, 200)}`);
    return text.trim();
  }

  // OpenAI-compatible format (default)
  const response = await fetch(normalizeOpenAICompatibleUrl(url), {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${api_key}`,
    },
    body: JSON.stringify({
      model: model ?? 'gpt-4o',
      messages,
      temperature: 0,
    }),
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`API error ${response.status}: ${error}`);
  }

  const data = await response.json();
  const text = data?.choices?.[0]?.message?.content;
  if (typeof text !== 'string') throw new Error(`Unexpected API response shape: ${JSON.stringify(data).slice(0, 200)}`);
  return text.trim();
}

// ── Slash command handlers ─────────────────────────────────
async function handleSlashCommand(input, config, rl, sessionState) {
  const parts = input.slice(1).split(/\s+/);
  const cmd = parts[0];
  const args = parts.slice(1);

  switch (cmd) {
    case 'help':
      console.log(buildHelpBanner());
      return config;

    case 'model':
      if (!args[0] || args[0] === 'show') {
        printSectionHeader('MODEL', 'command');
        console.log(`${formatSessionSnapshot(buildCliModelView(config), { public: true })}\n`);
        return config;
      }

      try {
        let update;
        if (args[0] === 'set' && args[1]) {
          update = await applyConfigUpdate(config, 'model', args[1], args.slice(2).join(' '), rl);
        } else {
          update = await applyConfigUpdate(config, 'model', 'model', args.join(' '), rl);
        }
        config = update.config;
        console.log(`  ${G('✓')} Updated ${update.key} = ${C(String(update.displayValue ?? '(default)'))}\n`);
      } catch (err) {
        console.log(`  ${Y(err.message)}\n`);
        console.log(`  ${D('Usage:')} /model [show] | /model <model> | /model set <provider|model|base_url|api_key> <value>\n`);
      }
      return config;

    case 'setting':
    case 'config': {
      if (!args[0] || args[0] === 'show') {
        const persisted = await loadSessionSnapshot();
        const settingsView = buildCliSettingsView(config, sessionState, persisted);
        printSectionHeader('SETTINGS', 'command');
        console.log(`${formatSessionSnapshot(settingsView, { public: false })}\n`);
        return config;
      }

      try {
        let update;
        if (args[0] === 'set' && args[1]) {
          update = await applyConfigUpdate(config, 'setting', args[1], args.slice(2).join(' '), rl);
        } else if (args[0]) {
          update = await applyConfigUpdate(config, 'setting', args[0], args.slice(1).join(' '), rl);
        }
        if (!update) {
          console.log(`  ${Y('Usage:')} /setting [show] | /setting set <key> <value>\n`);
          return config;
        }
        config = update.config;
        console.log(`  ${G('✓')} Updated ${update.key} = ${C(String(update.displayValue ?? '(default)'))}\n`);
        return config;
      } catch (err) {
        console.log(`  ${Y(err.message)}\n`);
      }

      console.log(`  ${Y('Usage:')} /setting [show] | /setting set <provider|base_url|model|api_key|approval_policy|max_iterations|notification_command> <value>\n`);
      return config;
    }

    case 'status': {
      const persisted = await loadSessionSnapshot();
      const status = buildCliStatusSnapshot(config, sessionState, persisted);
      printSectionHeader('STATUS', 'command');
      console.log(`${formatSessionSnapshot(status, { public: true })}\n`);
      return config;
    }

    case 'resume': {
      const { askApproval, resumeLastTarget } = await import('../agents/executor/index.js');
      const approved = await askApproval(rl, sessionState);
      if (!approved) {
        console.log(`  ${Y('Resume cancelled.')}\n`);
        return config;
      }
      await resumeLastTarget(config, sessionState);
      return config;
    }

    case 'plan': {
      const persisted = await loadSessionSnapshot();
      printSectionHeader('REPAIR PLAN', 'command');
      console.log(buildCliPlanView(sessionState, persisted));
      console.log('');
      return config;
    }

    case 'review': {
      printSectionHeader('REVIEW', 'command');
      const persisted = await loadSessionSnapshot();
      const review = buildCliReviewSnapshot(sessionState, persisted);
      console.log(`${formatSessionSnapshot(review, { public: true })}\n`);
      return config;
    }

    case 'transcript':
    case 'log': {
      const persisted = await loadSessionSnapshot();
      const transcript = buildCliTranscriptView(sessionState, persisted);
      if (!transcript.transcript) {
        console.log(`  ${Y('No transcript available yet.')}\n`);
        return config;
      }
      printSectionHeader('TRANSCRIPT', 'command');
      console.log(`${formatSessionSnapshot(transcript, { public: true })}\n`);
      return config;
    }

    case 'artifacts': {
      const persisted = await loadSessionSnapshot();
      printSectionHeader('ARTIFACTS', 'command');
      const artifacts = buildCliArtifactsView(sessionState, persisted);
      console.log(`${formatSessionSnapshot(artifacts, { public: true })}\n`);
      return config;
    }

    case 'demo':
      if (!args[0]) {
        console.log(`  ${Y('Usage:')} /demo <scenario-path> [--keep-container]\n`);
        console.log(`  ${D('Available scenarios:')}`);
        console.log(`    scenarios/docker-copy-path-bug`);
        console.log(`    scenarios/ci-python-version-drift`);
        console.log(`    scenarios/docker-healthcheck-failure`);
        console.log(`    scenarios/docker-multistage-wrong-artifact`);
        console.log(`    scenarios/docker-run-missing-env`);
        console.log(`    scenarios/env-missing-node\n`);
        return config;
      }
      try {
        const { askApproval, executeScenarioPath } = await import('../agents/executor/index.js');
        const approved = await askApproval(rl, sessionState);
        if (!approved) {
          console.log(`  ${Y('Demo cancelled.')}\n`);
          return config;
        }
        await executeScenarioPath(args[0], config, sessionState, parseExecutionFlags(args.slice(1)));
      } catch (err) {
        console.log(`  ${pc.red('Error:')} ${err.message}\n`);
      }
      return config;

    case 'doctor':
      try {
        const { checkEnvironment } = await import('../agents/verifier/index.js');
        await checkEnvironment();
      } catch (err) {
        console.log(`  ${pc.red('Error:')} ${err.message}\n`);
      }
      return config;

    case 'agents':
      console.log(`\n  ${B('Built-in Agents:')}`);
      console.log(`  ${G('●')} triage      CI/deployment failure classifier`);
      console.log(`  ${G('●')} fixer       Minimal patch proposer`);
      console.log(`  ${G('●')} verifier    Command runner + evidence capture`);
      // Built-in skills (directory format: skills/<name>/SKILL.md)
      try {
        const { readdir } = await import('node:fs/promises');
        const { join, dirname } = await import('node:path');
        const { fileURLToPath } = await import('node:url');
        const __dir = dirname(fileURLToPath(import.meta.url));
        const builtinDir = join(__dir, '..', 'skills');
        const entries = await readdir(builtinDir, { withFileTypes: true });
        const builtinSkills = entries.filter(e => e.isDirectory()).map(e => e.name);
        if (builtinSkills.length > 0) {
          console.log(`\n  ${B('Built-in Skills:')}`);
          builtinSkills.forEach(s => console.log(`  ${G('●')} ${s}`));
        }
      } catch { /* skills dir may not exist */ }
      // User skills — unified directory format: ~/.decipher/skills/<name>/SKILL.md
      console.log(`\n  ${B('User Skills')} ${D('(~/.decipher/skills/<name>/SKILL.md)')}`);
      try {
        const { readdir, access } = await import('node:fs/promises');
        const { join } = await import('node:path');
        const { homedir: hd } = await import('node:os');
        const userSkillsDir = join(hd(), '.decipher', 'skills');
        const entries = await readdir(userSkillsDir, { withFileTypes: true });
        // Accept both directory format (name/SKILL.md) and legacy flat .md files
        const skills = [];
        for (const e of entries) {
          if (e.isDirectory()) {
            skills.push(e.name);
          } else if (e.isFile() && e.name.endsWith('.md')) {
            skills.push(e.name.replace('.md', '') + ' (legacy)');
          }
        }
        if (skills.length > 0) {
          skills.forEach(s => console.log(`  ${C('●')} ${s}`));
        } else {
          console.log(`    ${D('(none installed)')}`);
        }
      } catch {
        console.log(`    ${D('(none installed)')}`);
      }
      console.log(`\n  ${D('Add skill: mkdir -p ~/.decipher/skills/my-skill && cp skill.md ~/.decipher/skills/my-skill/SKILL.md')}\n`);
      return config;

    case 'quit':
    case 'exit':
      return null; // Signal to exit

    default: {
      // Check if it's a close fuzzy match to a real command
      const suggestion = suggestCliSlashCommand(cmd);
      if (suggestion && cmd.length <= suggestion.length) {
        console.log(`  ${D('Did you mean:')} ${C(suggestion)}\n`);
        return config;
      }
      // Not a command — treat as natural language mission input.
      // Strip the leading / and pass through to the mission handler.
      console.log(pc.dim(`  (tip: / is for commands like /model, /status — treating as mission)\n`));
      await handleInteractiveInput(input.slice(1).trim(), config, rl, sessionState);
      return config;
    }
  }
}

// ── Codex-style boxed prompt ───────────────────────────────
function termWidth() {
  return process.stdout.columns || 80;
}
function dividerLine() {
  return pc.dim('─'.repeat(termWidth()));
}

// ── Interactive mode ───────────────────────────────────────
async function runInteractive() {
  let config = await ensureApiKey();
  if (!config) return;
  const historyEntries = await loadHistoryEntries(getHistoryPath());

  const sessionState = {
    approved: false,
    approvalPolicy: config.approval_policy ?? 'on-request',
    currentTarget: null,
    currentMission: null,
    currentPlan: null,
    lastVerificationResult: null,
    lastRunResult: null,
    historyEntries,
    reverseSearch: { active: false, originalLine: '' },
  };

  console.log(buildSessionHeader(config, sessionState));

  // update-check.js removed — Rust TUI is the primary interface.

  console.log(`  ${D('Type a mission, paste a path, or')} ${C('/help')} ${D('for commands.')}`)
  console.log(`  ${D('ctrl+r')} ${D('history')}  ${D('ctrl+c')} ${D('quit')}\n`);

  const rl = createInterface({
    input: process.stdin,
    output: process.stdout,
    prompt: `${C('❯')} `,
    completer: completeSlashCommand,
    terminal: true,
  });
  rl.history = toReadlineHistory(historyEntries);

  // Override _ttyWrite to intercept ALL keys before readline processes them.
  // For popup navigation keys (Up/Down/Enter/Tab/Escape): swallow completely.
  // For typing keys: clear popup → let readline process → re-render popup.
  // This prevents the cursor position fight between readline and our popup.
  const originalTtyWrite = rl._ttyWrite.bind(rl);
  rl._ttyWrite = function (char, key) {
    if (popupActive && key) {
      // Navigation keys — swallow, don't pass to readline
      if (key.name === 'up') {
        popupIndex = Math.max(0, popupIndex - 1);
        popup.render(popupItems, popupIndex);
        rl._refreshLine(); // restore cursor on input line
        return;
      }
      if (key.name === 'down') {
        popupIndex = Math.min(popupItems.length - 1, popupIndex + 1);
        popup.render(popupItems, popupIndex);
        rl._refreshLine();
        return;
      }
      if (key.name === 'return') {
        selectPopupItem();
        return;
      }
      if (key.name === 'tab') {
        selectPopupItem();
        return;
      }
      if (key.name === 'escape') {
        dismissPopup(true);
        return;
      }
    }

    // Clear popup before readline processes the key
    if (popupActive) {
      popup.clear();
    }

    // Let readline handle the key normally
    originalTtyWrite(char, key);

    // After readline updates, check if we should show/update the popup
    setImmediate(() => {
      if (closed || processing) return;
      const line = rl.line ?? '';
      if (line.startsWith('/') || /[.\/~]/.test(line) || line.startsWith('scenarios')) {
        updatePopup();
        rl._refreshLine(); // restore cursor after popup renders
      } else if (popupActive) {
        dismissPopup();
      }
    });
  };

  emitKeypressEvents(process.stdin, rl);
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
  }

  let closed = false;
  let processing = false;

  // ── Command palette popup state ──────────────────────────
  // popup.js removed — Rust TUI renders command popup natively.
  // Stubs for fallback interactive mode.
  const popup = { show() {}, hide() {}, isVisible() { return false; }, render() { return ''; } };
  const filterCommandsForPopup = () => [];
  const filterPathsForPopup = () => [];
  let popupActive = false;
  let popupItems = [];
  let popupIndex = 0;
  let popupOriginalLine = '';

  function updatePopup() {
    const line = rl.line ?? '';
    if (line.startsWith('/')) {
      if (!popupActive) {
        popupOriginalLine = line;
        popupIndex = 0;
      }
      const newItems = filterCommandsForPopup(line, SLASH_COMMANDS);
      // Reset index when filter results change
      if (newItems.length !== popupItems.length) popupIndex = 0;
      popupItems = newItems;
      popupIndex = Math.min(popupIndex, Math.max(0, popupItems.length - 1));
      if (popupItems.length > 0) {
        popup.render(popupItems, popupIndex);
        popupActive = true;
      } else {
        popup.clear();
        popupActive = false;
      }
      popupOriginalLine = line; // always track latest typed text
    } else if (/[.\/~]/.test(line) || line.startsWith('scenarios')) {
      if (!popupActive) {
        popupOriginalLine = line;
        popupIndex = 0;
      }
      popupItems = filterPathsForPopup(line);
      popupIndex = Math.min(popupIndex, Math.max(0, popupItems.length - 1));
      if (popupItems.length > 0) {
        popup.render(popupItems, popupIndex);
        popupActive = true;
      } else {
        popup.clear();
        popupActive = false;
      }
      popupOriginalLine = line;
    } else {
      dismissPopup();
    }
  }

  function dismissPopup(restoreOriginal = false) {
    if (popupActive) {
      popup.clear();
      popupActive = false;
      popupItems = [];
      popupIndex = 0;
      if (restoreOriginal && popupOriginalLine) {
        rl.line = popupOriginalLine;
        rl.cursor = popupOriginalLine.length;
      }
      popupOriginalLine = '';
      rl._refreshLine();
    }
  }

  function selectPopupItem() {
    if (!popupActive || popupItems.length === 0) return false;
    const selected = popupItems[popupIndex];
    if (!selected) return false;
    popup.clear();
    popupActive = false;
    popupItems = [];
    popupIndex = 0;

    // Directly replace readline buffer — no simulated keypresses.
    // rl.write() would re-trigger keypress events and cause loops.
    rl.line = selected.label;
    rl.cursor = selected.label.length;
    rl._refreshLine();
    return true;
  }

  function showPrompt() {
    if (closed) return;
    const mode = sessionState.reverseSearch.active ? 'SEARCH' : 'YOU';
    const frame = buildPromptFrame(mode);
    process.stdout.write(`${frame.top}\n`);
    rl.setPrompt(frame.prompt);
    rl.prompt();
  }

  // Ctrl+C: interrupt or quit
  rl.on('SIGINT', () => {
    if (processing) {
      console.log(pc.yellow('\n  Interrupted.'));
      processing = false;
      showPrompt();
    } else {
      closed = true;
      rl.close();
    }
  });

  process.stdin.on('keypress', (_char, key) => {
    if (closed || processing) return;

    // ── Reverse search mode ──────────────────────────────────
    if (sessionState.reverseSearch.active && key?.name === 'escape') {
      sessionState.reverseSearch.active = false;
      rl.prompt();
      rl.write(sessionState.reverseSearch.originalLine);
      return;
    }

    if (key?.ctrl && key.name === 'r') {
      dismissPopup();
      sessionState.reverseSearch = {
        active: true,
        originalLine: rl.line,
      };
      printSectionHeader('HISTORY SEARCH', 'command');
      console.log(`  ${D('Type a query and press Enter to restore the best match.')}\n`);
      rl.prompt();
      return;
    }

    // Popup triggering and rendering is fully handled in rl._ttyWrite override.
    // No duplicate logic here.
  });

  showPrompt();

  rl.on('line', async (input) => {
    // Popup selection inserts the command into the buffer — suppress this
    // empty line event so the user can review and press Enter again to submit.
    dismissPopup();
    if (processing) return;
    processing = true;

    const trimmed = input.trim();

    // Bottom border — closes the input box
    process.stdout.write(`${buildPromptFrame(sessionState.reverseSearch.active ? 'SEARCH' : 'YOU').bottom}\n`);

    if (!trimmed) {
      processing = false;
      showPrompt();
      return;
    }

    if (sessionState.reverseSearch.active) {
      const matches = findReverseHistoryMatches(sessionState.historyEntries, trimmed);
      sessionState.reverseSearch.active = false;
      if (matches.length === 0) {
        console.log(`  ${Y('No history match found.')}\n`);
        processing = false;
        showPrompt();
        rl.write(sessionState.reverseSearch.originalLine);
        return;
      }
      processing = false;
      showPrompt();
      rl.write(matches[0]);
      return;
    }

    if (trimmed.startsWith('/')) {
      if (trimmed === '/') {
        showSlashSuggestions('/');
        processing = false;
        showPrompt();
        return;
      }
      await appendHistoryEntry(getHistoryPath(), trimmed);
      sessionState.historyEntries.push({ text: trimmed });
      config = await handleSlashCommand(trimmed, config, rl, sessionState);
      sessionState.approvalPolicy = config?.approval_policy ?? sessionState.approvalPolicy;
      if (config === null) {
        closed = true;
        rl.close();
        processing = false;
        return;
      }
    } else {
      await appendHistoryEntry(getHistoryPath(), trimmed);
      sessionState.historyEntries.push({ text: trimmed });
      // Executor-first: detect if input contains an actionable target
      await handleInteractiveInput(trimmed, config, rl, sessionState);
    }

    processing = false;
    showPrompt();
  });

  rl.on('close', () => {
    closed = true;
    console.log(`\n  ${D('Goodbye!')}\n`);
  });
}

// ── CLI subcommands (non-interactive) ──────────────────────
const [,, command, ...args] = process.argv;

async function main() {
  switch (command) {
    case 'demo': {
      const scenarioPath = args.find((arg) => !arg.startsWith('-'));
      if (!scenarioPath) {
        console.error('Usage: decipher demo <scenario-path> [--keep-container]');
        process.exit(1);
      }
      const config = await ensureApiKey();
      if (!config) process.exit(3);
      const { executeScenarioPath } = await import('../agents/executor/index.js');
      await executeScenarioPath(scenarioPath, config, {
        approved: config.approval_policy !== 'on-request',
        approvalPolicy: config.approval_policy ?? 'on-request',
      }, parseExecutionFlags(args));
      break;
    }

    case 'doctor': {
      const { checkEnvironment } = await import('../agents/verifier/index.js');
      const result = await checkEnvironment();
      process.exit(result.allPassed ? 0 : 1);
    }

    case 'bootstrap': {
      const { generateBootstrapPlan } = await import('../agents/verifier/index.js');
      await generateBootstrapPlan();
      break;
    }

    case 'triage': {
      if (!args[0]) {
        console.error('Usage: decipher triage <log-file>');
        process.exit(1);
      }
      const config = await ensureApiKey();
      if (!config) process.exit(3);
      const { triageLog } = await import('../agents/triage/index.js');
      const { formatSection } = await import('../lib/reporter.js');
      const result = await triageLog(args[0], {}, config);
      console.log(formatSection('CLASSIFICATION', `  label:      ${result.classification}\n  confidence: ${result.confidence}`));
      console.log(formatSection('EVIDENCE', result.root_causes.map(rc => `  ${rc.hypothesis}: ${rc.evidence}`).join('\n')));
      break;
    }

    case 'verify': {
      const cmd = args.join(' ');
      if (!cmd) {
        console.error('Usage: decipher verify "<command>"');
        process.exit(1);
      }
      const { runVerification } = await import('../agents/verifier/index.js');
      const { formatSection } = await import('../lib/reporter.js');
      const result = await runVerification(cmd);
      console.log(formatSection('VERIFICATION', [
        `  Command:   ${cmd}`,
        `  Exit code: ${result.exit_code}`,
        `  Result:    ${result.result}`,
        result.stdout_excerpt ? `\n${result.stdout_excerpt.split('\n').slice(0, 5).map(l => `  ${l}`).join('\n')}` : '',
      ].join('\n')));
      process.exit(result.result === 'PASS' ? 0 : 1);
    }

    case 'config':
    case 'setting': {
      if (args[0] === 'set' && args[1] && args[2]) {
        const key = normalizeConfigKey(args[1]);
        if (!canUpdateConfigKey(key, 'setting')) {
          throw new Error(`Unsupported setting '${args[1]}'`);
        }
        const value = coerceConfigValue(key, args.slice(2).join(' '));
        const next = await writeConfig({ [key]: value });
        console.log(`Set ${key} = ${key === 'api_key' ? maskSecret(next.api_key) : value ?? '(default)'}`);
      } else if (args[0] === 'show') {
        const config = await readConfig();
        console.log(JSON.stringify(buildCliSettingsView(config, { lastRunResult: null }, null), null, 2));
      } else if (args[0] === 'reset') {
        const { rm } = await import('node:fs/promises');
        await rm(getConfigDir(), { recursive: true, force: true });
        console.log('Config reset.');
      } else {
        console.log('Usage: decipher setting set <key> <value>');
        console.log('       decipher setting show');
        console.log('       decipher setting reset');
      }
      break;
    }

    case '--help':
    case '-h':
      console.log(buildHelpBanner());
      break;

    case '--version':
    case '-v':
      console.log(`decipher v${VERSION}`);
      break;

    case '--server': {
      const { runServerMode } = await import('../lib/server-mode.js');
      await runServerMode();
      break;
    }

    default: {
      // Try Rust TUI if available, fall back to Node.js readline
      const tuiPath = await findTuiBinary();
      if (tuiPath && !process.env.DECIPHER_NO_TUI) {
        const { spawnSync } = await import('node:child_process');
        const result = spawnSync(tuiPath, [], {
          stdio: 'inherit',
          env: { ...process.env, DECIPHER_AGENT_SCRIPT: resolve(import.meta.dirname, 'decipher') },
        });
        if (result.status !== 0 && result.status !== null) {
          // TUI crashed — fall back to Node.js readline
          await runInteractive();
        }
      } else {
        await runInteractive();
      }
      break;
    }
  }
}

async function findTuiBinary() {
  const { access } = await import('node:fs/promises');
  const { dirname, join } = await import('node:path');
  const { fileURLToPath } = await import('node:url');

  // Check next to this script (npm install location)
  const binDir = dirname(fileURLToPath(import.meta.url));
  const localPath = join(binDir, 'decipher-tui');
  try {
    await access(localPath);
    return localPath;
  } catch { /* not found */ }

  // Check in PATH
  const { execSync } = await import('node:child_process');
  try {
    const p = execSync('which decipher-tui 2>/dev/null', { encoding: 'utf8' }).trim();
    if (p) return p;
  } catch { /* not in PATH */ }

  return null;
}

function flushStream(stream) {
  return new Promise((resolve) => stream.write('', resolve));
}

async function flushStdIO() {
  await Promise.all([flushStream(process.stdout), flushStream(process.stderr)]);
}

main()
  .then(async () => {
    await flushStdIO();
  })
  .catch(async (err) => {
    console.error(`Error: ${err.message}`);
    await flushStdIO();
    process.exit(3);
  });
