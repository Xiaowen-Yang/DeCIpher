#!/usr/bin/env node
// DeCIpher CLI entry point

import { createInterface, emitKeypressEvents } from 'node:readline';
import { resolve } from 'node:path';
import { homedir } from 'node:os';
import { pathToFileURL } from 'node:url';
import {
  readConfig,
  writeConfig,
  maskConfig,
  normalizeConfigKey,
  getHistoryPath,
  getConfigDir,
  getSessionPath,
} from '../lib/config.js';
import {
  appendHistoryEntry,
  loadHistoryEntries,
  toReadlineHistory,
  findReverseHistoryMatches,
} from '../lib/history.js';
import {
  loadSessionSnapshot,
  formatSessionSnapshot,
} from '../lib/session-store.js';
import pc from 'picocolors';

const VERSION = '0.1.0';

// ── Color helpers ──────────────────────────────────────────
const C  = (s) => pc.cyan(s);
const BC = (s) => pc.bold(pc.cyan(s));
const Y  = (s) => pc.yellow(s);
const BY = (s) => pc.bold(pc.yellow(s));
const G  = (s) => pc.green(s);
const D  = (s) => pc.dim(s);
const B  = (s) => pc.bold(s);
const W  = (s) => pc.white(s);

const SLASH_COMMANDS = [
  { name: '/help', description: 'Show help and commands' },
  { name: '/model', description: 'Show or change model' },
  { name: '/setting', description: 'Show or update configuration' },
  { name: '/status', description: 'Show current session status' },
  { name: '/resume', description: 'Resume last executor session' },
  { name: '/plan', description: 'Show current repair plan' },
  { name: '/review', description: 'Review current repair state and patch' },
  { name: '/transcript', description: 'Show last executor transcript' },
  { name: '/log', description: 'Alias for transcript' },
  { name: '/artifacts', description: 'Show saved artifacts and workspace' },
  { name: '/demo', description: 'Run a demo scenario' },
  { name: '/doctor', description: 'Check environment' },
  { name: '/agents', description: 'List available agents' },
  { name: '/quit', description: 'Exit' },
];

// ── Banner ─────────────────────────────────────────────────
function shortenPath(p) {
  const home = homedir();
  return p.startsWith(home) ? '~' + p.slice(home.length) : p;
}

function stripAnsi(s) {
  return s.replace(/\x1b\[[0-9;]*m/g, '');
}

function truncate(s, max) {
  if (s.length <= max) return s;
  return s.slice(0, max - 3) + '...';
}

function buildSessionHeader(config, sessionState = {}) {
  const dir = shortenPath(process.cwd());
  const provider = config.provider ?? 'openai';
  const model = config.model ?? 'gpt-4o';
  const hasKey = config.api_key ? G('●') : pc.red('○');
  const approvalPolicy = sessionState.approvalPolicy ?? config.approval_policy ?? 'on-request';
  const lastState = sessionState.lastVerificationResult ?? 'idle';

  // Truncate base_url for display
  const baseUrlDisplay = config.base_url
    ? D('  (' + truncate(config.base_url, 40) + ')')
    : '';

  const contentLines = [
    `                  ${BY('/\\_/\\')}`,
    `                 ${BY('( •ᴥ• )')}`,
    `${B('>_')} ${BC('DeCIpher')} ${D(`(v${VERSION})`)}`,
    ``,
    `${D('provider:')}  ${C(provider)}${baseUrlDisplay}`,
    `${D('model:')}     ${C(model)}              ${D('/model to change')}`,
    `${D('directory:')} ${W(dir)}`,
    `${D('approval:')}  ${C(approvalPolicy)}          ${D(`/status last:${lastState}`)}`,
    `${D('api key:')}   ${hasKey} ${config.api_key ? D('configured') : pc.red('not set')}`,
  ];

  // Dynamic width: at least 60, expand if needed
  const maxContent = Math.max(...contentLines.map(l => stripAnsi(l).length));
  const width = Math.max(60, maxContent + 4);

  const top = `╭${'─'.repeat(width)}╮`;
  const bot = `╰${'─'.repeat(width)}╯`;
  const boxed = contentLines.map(line => {
    const stripped = stripAnsi(line);
    const pad = Math.max(0, width - 2 - stripped.length);
    return `│ ${line}${' '.repeat(pad)} │`;
  });

  return [top, ...boxed, bot].join('\n');
}

function buildHelpBanner() {
  return [
    '',
    BY('                                  /\\_/\\  '),
    BY('                                 ( •ᴥ• )'),
    BY(' ____  ____  ___  __  ____  _  _  ____  ____'),
    BY('(    \\(  __)/ __)(  )(  _ \\/ )( \\(  __)(  _ \\'),
    BY(' ) D ( ) _)( (__  )(  ) __/) __ ( ) _)  )   /'),
    BY('(____/(____)\\___)(__)(__) \\_)(_/(____)(____/'),
    D(''),
    D('        AI CI Troubleshooter'),
    '',
    `  ${B('Usage:')}  decipher [command] [args]`,
    '',
    `  ${B('Commands:')}`,
    `    ${G('decipher')}                    Interactive mode`,
    `    ${G('decipher demo')} ${D('<scenario>')}   Run a demo scenario`,
    `    ${G('decipher doctor')}              Check environment`,
    `    ${G('decipher triage')} ${D('<log>')}      Triage a failure log`,
    `    ${G('decipher verify')} ${D('"<cmd>"')}    Run a verification command`,
    `    ${G('decipher setting')} ${D('show|set')}    Manage configuration`,
    '',
    `  ${B('Interactive commands:')}`,
    `    ${C('/help')}                       Show this help`,
    `    ${C('/model')} ${D('[name]')}              Show model status or change model`,
    `    ${C('/setting')} ${D('[show|set k v]')}     Configuration`,
    `    ${C('/status')}                     Current session snapshot`,
    `    ${C('/resume')}                     Resume last failed session`,
    `    ${C('/plan')}                       Current repair plan`,
    `    ${C('/review')}                     Review patch and write-back`,
    `    ${C('/transcript')}                 Show last transcript`,
    `    ${C('/log')}                        Alias for transcript`,
    `    ${C('/artifacts')}                  Show last artifacts`,
    `    ${C('/demo')} ${D('<scenario>')}           Run a demo scenario`,
    `    ${C('/doctor')}                     Check environment`,
    `    ${C('/agents')}                     List available agents`,
    `    ${C('/quit')}                       Exit`,
    '',
  ].join('\n');
}

function showSlashSuggestions(prefix = '/') {
  const matches = SLASH_COMMANDS.filter(command => command.name.startsWith(prefix));
  printSectionHeader('COMMAND PALETTE', 'command');
  matches.forEach(command => {
    console.log(`  ${C(command.name.padEnd(12))} ${D(command.description)}`);
  });
  console.log('');
}

function buildModelStatus(config) {
  const safe = maskConfig(config);
  return [
    `  ${D('provider:')} ${C(safe.provider)}`,
    `  ${D('model:')}    ${C(safe.model)}`,
    `  ${D('base_url:')} ${safe.base_url ? C(safe.base_url) : D('(default)')}`,
    `  ${D('api_key:')}  ${safe.api_key ? C(safe.api_key) : D('(not set)')}`,
  ].join('\n');
}

function buildStatusSnapshot(config, sessionState, persisted = null) {
  return {
    cwd: process.cwd(),
    target: sessionState.currentTarget?.path ?? persisted?.target_path ?? null,
    approval_state: sessionState.approved ?? false,
    approval_policy: sessionState.approvalPolicy ?? config.approval_policy ?? 'on-request',
    model: config.model,
    provider: config.provider,
    base_url: config.base_url,
    retry_budget: config.max_iterations,
    last_verification_result: sessionState.lastVerificationResult ?? persisted?.last_verification_state ?? null,
    temp_workspace_path: sessionState.lastRunResult?.workspace ?? persisted?.workspace_path ?? null,
    writable_roots: [process.cwd(), '/tmp'],
    persistence: {
      config_dir: getConfigDir(),
      history_path: getHistoryPath(),
      session_path: getSessionPath(),
    },
    network: 'blocked/unknown',
  };
}

function suggestSlashCommand(cmd) {
  const normalized = `/${cmd}`;
  if (normalized === '/settings') return '/setting';
  const exact = SLASH_COMMANDS.find(item => item.name === normalized);
  if (exact) return exact.name;
  return SLASH_COMMANDS.find(item => item.name.startsWith(normalized))?.name ?? null;
}

function completeSlashCommand(line) {
  if (!line.startsWith('/')) {
    return [[], line];
  }

  const hits = SLASH_COMMANDS
    .map((command) => command.name)
    .filter((name) => name.startsWith(line));

  return [hits.length ? hits : SLASH_COMMANDS.map((command) => command.name), line];
}

function panelWidth(title) {
  return Math.max(54, Math.min(termWidth() - 2, 78), stripAnsi(title).length + 10);
}

function printSectionHeader(label, tone = 'agent') {
  const colorize = tone === 'input' ? BY : tone === 'command' ? Y : BC;
  console.log(`\n${D('┌')} ${colorize(label)} ${D('─'.repeat(Math.max(8, termWidth() - stripAnsi(label).length - 8)))}`);
}

function buildPromptFrame(mode = 'YOU') {
  const width = panelWidth(mode);
  const top = `${D('╭')}${D('─')} ${mode === 'SEARCH' ? Y(mode) : BY(mode)} ${D('─'.repeat(Math.max(8, width - stripAnsi(mode) - 4)))}`;
  const prompt = `${D('│')} ${mode === 'SEARCH' ? Y('SEARCH') : BY('YOU')} ${C('›')} `;
  const bottom = `${D('╰')}${D('─'.repeat(width))}`;
  return { top, prompt, bottom };
}

function buildCurrentPlan(sessionState, persisted = null) {
  const target = sessionState.currentTarget?.path ?? persisted?.target_path;
  const lastState = sessionState.lastVerificationResult ?? persisted?.last_verification_state;
  const patch = sessionState.lastRunResult?.patch ?? persisted?.patch;
  const writtenBack = sessionState.lastRunResult?.writtenBack ?? persisted?.written_back ?? [];

  const steps = [
    { label: 'Resolve target', done: Boolean(target) },
    { label: 'Reproduce failure', done: Boolean(lastState && lastState !== 'PASS') },
    { label: 'Classify root cause', done: Boolean(sessionState.lastRunResult?.classification?.classification ?? persisted?.classification?.classification) },
    { label: 'Propose patch', done: Boolean(patch) },
    { label: 'Verify fix', done: lastState === 'PASS' },
    { label: 'Write back repaired files', done: writtenBack.length > 0 },
  ];

  return steps.map((step) => `  ${step.done ? G('●') : D('○')} ${step.label}`).join('\n');
}

async function buildReviewSnapshot(sessionState) {
  const persisted = await loadSessionSnapshot();
  const patch = sessionState.lastRunResult?.patch ?? persisted?.patch ?? null;
  const writtenBack = sessionState.lastRunResult?.writtenBack ?? persisted?.written_back ?? [];
  const classification = sessionState.lastRunResult?.classification?.classification ?? persisted?.classification?.classification ?? null;
  const confidence = sessionState.lastRunResult?.classification?.confidence ?? persisted?.classification?.confidence ?? null;

  return {
    target: sessionState.currentTarget?.path ?? persisted?.target_path ?? null,
    classification,
    confidence,
    last_state: sessionState.lastVerificationResult ?? persisted?.last_verification_state ?? null,
    workspace: sessionState.lastRunResult?.workspace ?? persisted?.workspace_path ?? null,
    would_write_back: writtenBack,
    patch_preview: patch ? patch.split('\n').slice(0, 12).join('\n') : null,
  };
}

// ── Hidden input (API key) ─────────────────────────────────
/**
 * Read a line from stdin without echoing characters (for API keys).
 * Uses TTY raw mode when available; falls back to normal readline in
 * non-TTY environments (pipes, CI).
 */
function askHiddenInput(prompt) {
  return new Promise((resolve) => {
    process.stdout.write(prompt);

    if (process.stdin.isTTY) {
      // Raw mode: characters are not echoed
      let value = '';
      process.stdin.setRawMode(true);
      process.stdin.resume();
      process.stdin.setEncoding('utf8');

      const onData = (char) => {
        if (char === '\n' || char === '\r' || char === '\u0004') {
          process.stdin.setRawMode(false);
          process.stdin.pause();
          process.stdin.removeListener('data', onData);
          process.stdout.write('\n');
          resolve(value.trim());
        } else if (char === '\u0003') {
          process.exit(); // Ctrl-C
        } else if (char === '\u007f' || char === '\u0008') {
          value = value.slice(0, -1); // Backspace
        } else {
          value += char;
        }
      };

      process.stdin.on('data', onData);
    } else {
      // Non-TTY (pipe / CI): read normally — no echoing in non-interactive shells
      const linerl = createInterface({ input: process.stdin });
      linerl.once('line', (line) => {
        linerl.close();
        resolve(line.trim());
      });
    }
  });
}

// ── First-run setup ────────────────────────────────────────
async function firstRunSetup() {
  console.log(`\n  ${B('Welcome to DeCIpher')} — ${D('AI CI Troubleshooter')}\n`);
  console.log(`  ${Y('No API key configured.')} Let's set one up.\n`);

  const rl = createInterface({ input: process.stdin, output: process.stdout });
  const ask = (q) => new Promise(resolve => rl.question(q, resolve));

  const provider = (await ask(`  ${D('Provider')} [openai/anthropic/custom]: `)).trim() || 'openai';

  let base_url = null;
  if (provider === 'custom' || !['openai', 'anthropic'].includes(provider)) {
    base_url = (await ask(`  ${D('Base URL')}: `)).trim() || null;
  }

  const model = (await ask(`  ${D('Model')} [${provider === 'anthropic' ? 'claude-sonnet-4-20250514' : 'gpt-4o'}]: `)).trim() ||
    (provider === 'anthropic' ? 'claude-sonnet-4-20250514' : 'gpt-4o');

  rl.close(); // Close before reading secret

  // Ask for API key with hidden input (no echo)
  const api_key = await askHiddenInput(`  ${D('API Key')} ${D('(input hidden)')}: `);

  if (!api_key) {
    console.log(`\n  ${pc.red('No API key provided. Exiting setup.')}\n`);
    return null;
  }

  const updates = { provider: base_url ? 'custom' : provider, model, api_key };
  if (base_url) updates.base_url = base_url;

  const config = await writeConfig(updates);
  console.log(`\n  ${G('✓')} Config saved to ~/.decipher/config.json\n`);
  return config;
}

async function ensureApiKey() {
  const config = await readConfig();
  if (config.api_key) return config;
  return await firstRunSetup();
}

// ── Interactive conversation ───────────────────────────────
async function collectContext() {
  const { exec } = await import('node:child_process');
  const { promisify } = await import('node:util');
  const run = promisify(exec);

  const ctx = {};
  try { ctx.git_status = (await run('git status --short')).stdout.trim(); } catch { ctx.git_status = ''; }
  try { ctx.git_diff = (await run('git diff --name-only HEAD')).stdout.trim(); } catch { ctx.git_diff = ''; }
  try { ctx.dockerfiles = (await run("find . -name 'Dockerfile*' -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null")).stdout.trim(); } catch { ctx.dockerfiles = ''; }
  try { ctx.workflows = (await run("find . -path '*/.github/workflows/*.yml' -not -path '*/node_modules/*' 2>/dev/null")).stdout.trim(); } catch { ctx.workflows = ''; }

  return Object.entries(ctx)
    .filter(([, v]) => v)
    .map(([k, v]) => `### ${k}\n${v}`)
    .join('\n\n') || 'No additional context collected.';
}

// Conversation history for multi-turn interaction
const conversationHistory = [];
let projectContext = null;
let skillsContent = null;

async function loadSkills() {
  if (skillsContent) return skillsContent;
  const { readFile } = await import('node:fs/promises');
  const { join, dirname } = await import('node:path');
  const { fileURLToPath } = await import('node:url');
  const __dir = dirname(fileURLToPath(import.meta.url));
  const skillsDir = join(__dir, '..', 'skills');

  let skills = '';
  for (const name of ['ci-triage', 'docker-debug', 'env-bootstrap']) {
    try {
      skills += await readFile(join(skillsDir, name, 'SKILL.md'), 'utf8') + '\n\n';
    } catch { /* skip */ }
  }
  skillsContent = skills;
  return skills;
}

/**
 * Executor-first input handler.
 *
 * Flow:
 *  1. Try to resolve an executable target (scenario dir, Dockerfile dir, log file).
 *  2. If found → ask one-time session approval → execute the pipeline.
 *  3. If not found → fall back to conversational LLM mode.
 */
async function handleInteractiveInput(input, config, rl, sessionState) {
  const { resolveTarget, detectAction, askApproval, executeTarget } =
    await import('../agents/executor/index.js');

  // ── Step 1: Target detection ──────────────────────────────
  let target = null;
  try {
    target = await resolveTarget(input);
  } catch { /* ignore resolution errors */ }

  if (target) {
    // ── Step 2: One-time approval ───────────────────────────
    const approved = await askApproval(rl, sessionState);
    if (!approved) {
      // Fall through to conversational mode
      await handleConversationalInput(input, config);
      return;
    }

    // ── Step 3: Execute pipeline ────────────────────────────
    const action = detectAction(input, target.type);
    console.log(
      `  ${pc.dim('Target:')} ${pc.cyan(target.path)}  ${pc.dim('Type:')} ${target.type}  ${pc.dim('Action:')} ${action}`,
    );
    try {
      await executeTarget(target, action, config, sessionState);
    } catch (err) {
      console.log(`  ${pc.red('Executor error:')} ${err.message}\n`);
    }
    return;
  }

  // ── Step 4: Conversational fallback ────────────────────────
  await handleConversationalInput(input, config);
}

/**
 * Pure conversational mode: sends input to the LLM as a CI/DevOps assistant.
 * Used when no executable target is detected, or when the user asks a question.
 */
async function handleConversationalInput(input, config) {
  const { TAXONOMY } = await import('../agents/triage/index.js');

  // Collect project context once per session
  if (!projectContext) {
    projectContext = await collectContext();
  }
  const skills = await loadSkills();

  const systemPrompt = `You are DeCIpher, an AI CI/deployment troubleshooting assistant running in an interactive terminal session. You help developers diagnose and fix CI pipeline failures, Docker build errors, deployment issues, and environment setup problems.

## Your personality
- Direct, concise, helpful — like a senior DevOps engineer pair-programming with the user
- Conversational tone, not robotic report format
- If the user pastes a file path or directory, remind them they can paste it directly and DeCIpher will execute automatically
- If the user greets you or asks non-CI questions, respond briefly and steer back to your expertise

## Your capabilities
- Classify CI/deployment failures into these categories: ${TAXONOMY.join(', ')}
- Analyze error logs and suggest root causes
- Propose minimal fixes with specific file changes
- Suggest verification commands
- Execute full triage → fix → verify pipelines when given a path

## Domain knowledge
${skills}

## Current project context
Directory: ${process.cwd()}
${projectContext}

## Response guidelines
- For greetings/casual input: respond naturally in 1-2 sentences, mention what you can help with
- For vague problems: ask 1-2 specific follow-up questions (which error? which file? which CI step?)
- For clear CI/deployment problems: give a direct diagnosis with:
  - What's wrong (1 sentence)
  - Why (brief root cause)
  - How to fix (specific commands or file changes)
  - How to verify (a command to run)
- Keep responses SHORT. No walls of text. Use bullet points for steps.
- Do NOT use the structured report format (**Classification:**, **Root Cause:**, etc.)
- Respond in the same language the user writes in (Chinese → Chinese, English → English)`;

  conversationHistory.push({ role: 'user', content: input });

  const messages = [
    { role: 'system', content: systemPrompt },
    ...conversationHistory,
  ];

  printSectionHeader('DECIPHER', 'agent');

  const { startSpinner } = await import('../lib/spinner.js');
  const sp = startSpinner('Thinking');
  try {
    const response = await callAIMultiTurn(messages, config);
    sp.stop('Response ready');

    conversationHistory.push({ role: 'assistant', content: response });

    if (conversationHistory.length > 20) {
      conversationHistory.splice(0, conversationHistory.length - 20);
    }

    const formatted = response
      .split('\n')
      .map(line => `  ${line}`)
      .join('\n');
    console.log(formatted);
    console.log('');
  } catch (err) {
    sp.stop();
    console.log(`  ${pc.red('Error:')} ${err.message}\n`);
  }
}

// Multi-turn AI call supporting message arrays
async function callAIMultiTurn(messages, config) {
  const { provider, api_key, model, base_url } = config;

  if (!api_key) {
    throw new Error('No API key configured. Run: decipher config set api-key <key>');
  }

  const url = base_url ?? (provider === 'anthropic'
    ? 'https://api.anthropic.com/v1/messages'
    : 'https://api.openai.com/v1/chat/completions');

  if (provider === 'anthropic' && !base_url) {
    // Anthropic format: extract system from messages
    const system = messages.find(m => m.role === 'system')?.content ?? '';
    const turns = messages.filter(m => m.role !== 'system');
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': api_key,
        'anthropic-version': '2023-06-01',
      },
      body: JSON.stringify({
        model: model ?? 'claude-sonnet-4-20250514',
        max_tokens: 1024,
        system,
        messages: turns,
      }),
    });
    if (!response.ok) {
      const error = await response.text();
      throw new Error(`Anthropic API error ${response.status}: ${error}`);
    }
    const data = await response.json();
    const text = data?.content?.[0]?.text;
    if (typeof text !== 'string') throw new Error(`Unexpected Anthropic response shape: ${JSON.stringify(data).slice(0, 200)}`);
    return text.trim();
  }

  // OpenAI-compatible format (default)
  const response = await fetch(url, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${api_key}`,
    },
    body: JSON.stringify({
      model: model ?? 'gpt-4o',
      messages,
      temperature: 0,
    }),
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`API error ${response.status}: ${error}`);
  }

  const data = await response.json();
  const text = data?.choices?.[0]?.message?.content;
  if (typeof text !== 'string') throw new Error(`Unexpected API response shape: ${JSON.stringify(data).slice(0, 200)}`);
  return text.trim();
}

// ── Slash command handlers ─────────────────────────────────
async function handleSlashCommand(input, config, rl, sessionState) {
  const parts = input.slice(1).split(/\s+/);
  const cmd = parts[0];
  const args = parts.slice(1);

  switch (cmd) {
    case 'help':
      console.log(buildHelpBanner());
      return config;

    case 'model':
      if (args[0]) {
        config = await writeConfig({ model: args[0] });
        console.log(`  ${G('✓')} Model changed to ${C(args[0])}\n`);
      } else {
        console.log(`\n${buildModelStatus(config)}\n`);
      }
      return config;

    case 'setting':
    case 'config': {
      if (!args[0] || args[0] === 'show') {
        const persisted = await loadSessionSnapshot();
        const settingsView = {
          ...maskConfig(config),
          execution_visibility: {
            writable_roots: [process.cwd(), '/tmp'],
            network: 'blocked/unknown',
            temp_workspace_path: sessionState.lastRunResult?.workspace ?? persisted?.workspace_path ?? null,
            persistence: {
              config_dir: getConfigDir(),
              history_path: getHistoryPath(),
              session_path: getSessionPath(),
            },
          },
        };
        printSectionHeader('SETTINGS', 'command');
        console.log(`${formatSessionSnapshot(settingsView, { public: false })}\n`);
        return config;
      }

      if (args[0] === 'set' && args[1]) {
        const key = normalizeConfigKey(args[1]);
        let value = args.slice(2).join(' ');

        if (key === 'api_key' && !value) {
          rl.pause();
          value = await askHiddenInput(`  ${D('API Key')} ${D('(input hidden)')}: `);
          rl.resume();
          if (process.stdin.isTTY) {
            process.stdin.setRawMode(true);
          }
        }

        if (!value) {
          console.log(`  ${Y('Usage:')} /setting set <provider|base_url|model|api_key|approval_policy> <value>\n`);
          return config;
        }

        config = await writeConfig({ [key]: value });
        console.log(`  ${G('✓')} Updated ${args[1]} = ${key === 'api_key' ? '***' : C(value)}\n`);
        return config;
      }

      console.log(`  ${Y('Usage:')} /setting [show] | /setting set <key> <value>\n`);
      return config;
    }

    case 'status': {
      const persisted = await loadSessionSnapshot();
      const status = buildStatusSnapshot(config, sessionState, persisted);
      printSectionHeader('STATUS', 'command');
      console.log(`${formatSessionSnapshot(status, { public: true })}\n`);
      return config;
    }

    case 'resume': {
      const { askApproval, resumeLastTarget } = await import('../agents/executor/index.js');
      const approved = await askApproval(rl, sessionState);
      if (!approved) {
        console.log(`  ${Y('Resume cancelled.')}\n`);
        return config;
      }
      await resumeLastTarget(config, sessionState);
      return config;
    }

    case 'plan': {
      const persisted = await loadSessionSnapshot();
      printSectionHeader('REPAIR PLAN', 'command');
      console.log(buildCurrentPlan(sessionState, persisted));
      console.log('');
      return config;
    }

    case 'review': {
      printSectionHeader('REVIEW', 'command');
      const review = await buildReviewSnapshot(sessionState);
      console.log(`${formatSessionSnapshot(review, { public: true })}\n`);
      return config;
    }

    case 'transcript':
    case 'log': {
      const transcript = sessionState.lastRunResult?.transcript;
      if (!transcript) {
        console.log(`  ${Y('No transcript available yet.')}\n`);
        return config;
      }
      console.log(`\n${transcript}\n`);
      return config;
    }

    case 'artifacts': {
      const persisted = await loadSessionSnapshot();
      printSectionHeader('ARTIFACTS', 'command');
      const artifacts = {
        target: sessionState.currentTarget?.path ?? persisted?.target_path ?? null,
        workspace: sessionState.lastRunResult?.workspace ?? persisted?.workspace_path ?? null,
        written_back: sessionState.lastRunResult?.writtenBack ?? persisted?.written_back ?? [],
        last_state: sessionState.lastVerificationResult ?? persisted?.last_verification_state ?? null,
        patch_preview: sessionState.lastRunResult?.patch?.split('\n').slice(0, 8).join('\n') ?? persisted?.patch ?? null,
      };
      console.log(`${formatSessionSnapshot(artifacts, { public: true })}\n`);
      return config;
    }

    case 'demo':
      if (!args[0]) {
        console.log(`  ${Y('Usage:')} /demo <scenario-path>\n`);
        console.log(`  ${D('Available scenarios:')}`);
        console.log(`    scenarios/docker-copy-path-bug`);
        console.log(`    scenarios/ci-python-version-drift`);
        console.log(`    scenarios/docker-healthcheck-failure`);
        console.log(`    scenarios/docker-multistage-wrong-artifact`);
        console.log(`    scenarios/docker-run-missing-env`);
        console.log(`    scenarios/env-missing-node\n`);
        return config;
      }
      try {
        const { askApproval, executeScenarioPath } = await import('../agents/executor/index.js');
        const approved = await askApproval(rl, sessionState);
        if (!approved) {
          console.log(`  ${Y('Demo cancelled.')}\n`);
          return config;
        }
        await executeScenarioPath(args[0], config, sessionState);
      } catch (err) {
        console.log(`  ${pc.red('Error:')} ${err.message}\n`);
      }
      return config;

    case 'doctor':
      try {
        const { checkEnvironment } = await import('../agents/verifier/index.js');
        await checkEnvironment();
      } catch (err) {
        console.log(`  ${pc.red('Error:')} ${err.message}\n`);
      }
      return config;

    case 'agents':
      console.log(`\n  ${B('Built-in Agents:')}`);
      console.log(`  ${G('●')} triage      CI/deployment failure classifier`);
      console.log(`  ${G('●')} fixer       Minimal patch proposer`);
      console.log(`  ${G('●')} verifier    Command runner + evidence capture`);
      // Built-in skills (directory format: skills/<name>/SKILL.md)
      try {
        const { readdir } = await import('node:fs/promises');
        const { join, dirname } = await import('node:path');
        const { fileURLToPath } = await import('node:url');
        const __dir = dirname(fileURLToPath(import.meta.url));
        const builtinDir = join(__dir, '..', 'skills');
        const entries = await readdir(builtinDir, { withFileTypes: true });
        const builtinSkills = entries.filter(e => e.isDirectory()).map(e => e.name);
        if (builtinSkills.length > 0) {
          console.log(`\n  ${B('Built-in Skills:')}`);
          builtinSkills.forEach(s => console.log(`  ${G('●')} ${s}`));
        }
      } catch { /* skills dir may not exist */ }
      // User skills — unified directory format: ~/.decipher/skills/<name>/SKILL.md
      console.log(`\n  ${B('User Skills')} ${D('(~/.decipher/skills/<name>/SKILL.md)')}`);
      try {
        const { readdir, access } = await import('node:fs/promises');
        const { join } = await import('node:path');
        const { homedir: hd } = await import('node:os');
        const userSkillsDir = join(hd(), '.decipher', 'skills');
        const entries = await readdir(userSkillsDir, { withFileTypes: true });
        // Accept both directory format (name/SKILL.md) and legacy flat .md files
        const skills = [];
        for (const e of entries) {
          if (e.isDirectory()) {
            skills.push(e.name);
          } else if (e.isFile() && e.name.endsWith('.md')) {
            skills.push(e.name.replace('.md', '') + ' (legacy)');
          }
        }
        if (skills.length > 0) {
          skills.forEach(s => console.log(`  ${C('●')} ${s}`));
        } else {
          console.log(`    ${D('(none installed)')}`);
        }
      } catch {
        console.log(`    ${D('(none installed)')}`);
      }
      console.log(`\n  ${D('Add skill: mkdir -p ~/.decipher/skills/my-skill && cp skill.md ~/.decipher/skills/my-skill/SKILL.md')}\n`);
      return config;

    case 'quit':
    case 'exit':
      return null; // Signal to exit

    default:
      console.log(`  ${Y('Unknown command:')} /${cmd}.`);
      const suggestion = suggestSlashCommand(cmd);
      if (suggestion) {
        console.log(`  ${D('Did you mean:')} ${C(suggestion)}\n`);
      } else {
        console.log(`  ${D('Type /help for available commands.')}\n`);
      }
      return config;
  }
}

// ── Codex-style boxed prompt ───────────────────────────────
function termWidth() {
  return process.stdout.columns || 80;
}
function dividerLine() {
  return pc.dim('─'.repeat(termWidth()));
}

// ── Interactive mode ───────────────────────────────────────
async function runInteractive() {
  let config = await ensureApiKey();
  if (!config) return;
  const historyEntries = await loadHistoryEntries(getHistoryPath());

  const sessionState = {
    approved: false,
    approvalPolicy: config.approval_policy ?? 'on-request',
    currentTarget: null,
    lastVerificationResult: null,
    lastRunResult: null,
    historyEntries,
    reverseSearch: { active: false, originalLine: '' },
    confirmWriteback: async (files) => {
      const { confirmWriteback } = await import('../agents/executor/index.js');
      return confirmWriteback(rl, sessionState, files);
    },
  };

  console.log(buildSessionHeader(config, sessionState));
  console.log(`\n  ${D('Paste a path to execute, or type')} ${C('/help')} ${D('for commands.')}\n`);

  const rl = createInterface({
    input: process.stdin,
    output: process.stdout,
    prompt: `${C('❯')} `,
    completer: completeSlashCommand,
    terminal: true,
  });
  rl.history = toReadlineHistory(historyEntries);

  emitKeypressEvents(process.stdin, rl);
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
  }

  let closed = false;
  let processing = false;

  function showPrompt() {
    if (closed) return;
    const mode = sessionState.reverseSearch.active ? 'SEARCH' : 'YOU';
    const frame = buildPromptFrame(mode);
    process.stdout.write(`${frame.top}\n`);
    rl.setPrompt(frame.prompt);
    rl.prompt();
  }

  process.stdin.on('keypress', (_char, key) => {
    if (closed || processing) return;

    if (sessionState.reverseSearch.active && key?.name === 'escape') {
      sessionState.reverseSearch.active = false;
      rl.prompt();
      rl.write(sessionState.reverseSearch.originalLine);
      return;
    }

    if (key?.ctrl && key.name === 'r') {
      sessionState.reverseSearch = {
        active: true,
        originalLine: rl.line,
      };
      printSectionHeader('HISTORY SEARCH', 'command');
      console.log(`  ${D('Type a query and press Enter to restore the best match.')}\n`);
      rl.prompt();
      return;
    }

    if (key?.sequence === '/' && rl.line === '') {
      showSlashSuggestions('/');
    }
  });

  showPrompt();

  rl.on('line', async (input) => {
    if (processing) return; // drop input while processing
    processing = true;

    const trimmed = input.trim();

    // Bottom border — closes the input box
    process.stdout.write(`${buildPromptFrame(sessionState.reverseSearch.active ? 'SEARCH' : 'YOU').bottom}\n`);

    if (!trimmed) {
      processing = false;
      showPrompt();
      return;
    }

    if (sessionState.reverseSearch.active) {
      const matches = findReverseHistoryMatches(sessionState.historyEntries, trimmed);
      sessionState.reverseSearch.active = false;
      if (matches.length === 0) {
        console.log(`  ${Y('No history match found.')}\n`);
        processing = false;
        showPrompt();
        rl.write(sessionState.reverseSearch.originalLine);
        return;
      }
      processing = false;
      showPrompt();
      rl.write(matches[0]);
      return;
    }

    if (trimmed.startsWith('/')) {
      if (trimmed === '/') {
        showSlashSuggestions('/');
        processing = false;
        showPrompt();
        return;
      }
      await appendHistoryEntry(getHistoryPath(), trimmed);
      sessionState.historyEntries.push({ text: trimmed });
      config = await handleSlashCommand(trimmed, config, rl, sessionState);
      sessionState.approvalPolicy = config?.approval_policy ?? sessionState.approvalPolicy;
      if (config === null) {
        closed = true;
        rl.close();
        processing = false;
        return;
      }
    } else {
      await appendHistoryEntry(getHistoryPath(), trimmed);
      sessionState.historyEntries.push({ text: trimmed });
      // Executor-first: detect if input contains an actionable target
      await handleInteractiveInput(trimmed, config, rl, sessionState);
    }

    processing = false;
    showPrompt();
  });

  rl.on('close', () => {
    closed = true;
    console.log(`\n  ${D('Goodbye!')}\n`);
  });
}

// ── CLI subcommands (non-interactive) ──────────────────────
const [,, command, ...args] = process.argv;

async function main() {
  switch (command) {
    case 'demo': {
      if (!args[0]) {
        console.error('Usage: decipher demo <scenario-path>');
        process.exit(1);
      }
      const config = await ensureApiKey();
      if (!config) process.exit(3);
      const { executeScenarioPath } = await import('../agents/executor/index.js');
      await executeScenarioPath(args[0], config, {
        approved: config.approval_policy !== 'on-request',
        approvalPolicy: config.approval_policy ?? 'on-request',
      });
      break;
    }

    case 'doctor': {
      const { checkEnvironment } = await import('../agents/verifier/index.js');
      const result = await checkEnvironment();
      process.exit(result.allPassed ? 0 : 1);
    }

    case 'bootstrap': {
      const { generateBootstrapPlan } = await import('../agents/verifier/index.js');
      await generateBootstrapPlan();
      break;
    }

    case 'triage': {
      if (!args[0]) {
        console.error('Usage: decipher triage <log-file>');
        process.exit(1);
      }
      const config = await ensureApiKey();
      if (!config) process.exit(3);
      const { triageLog } = await import('../agents/triage/index.js');
      const { formatSection } = await import('../lib/reporter.js');
      const result = await triageLog(args[0], {}, config);
      console.log(formatSection('CLASSIFICATION', `  label:      ${result.classification}\n  confidence: ${result.confidence}`));
      console.log(formatSection('EVIDENCE', result.root_causes.map(rc => `  ${rc.hypothesis}: ${rc.evidence}`).join('\n')));
      break;
    }

    case 'verify': {
      const cmd = args.join(' ');
      if (!cmd) {
        console.error('Usage: decipher verify "<command>"');
        process.exit(1);
      }
      const { runVerification } = await import('../agents/verifier/index.js');
      const { formatSection } = await import('../lib/reporter.js');
      const result = await runVerification(cmd);
      console.log(formatSection('VERIFICATION', [
        `  Command:   ${cmd}`,
        `  Exit code: ${result.exit_code}`,
        `  Result:    ${result.result}`,
        result.stdout_excerpt ? `\n${result.stdout_excerpt.split('\n').slice(0, 5).map(l => `  ${l}`).join('\n')}` : '',
      ].join('\n')));
      process.exit(result.result === 'PASS' ? 0 : 1);
    }

    case 'config':
    case 'setting': {
      if (args[0] === 'set' && args[1] && args[2]) {
        await writeConfig({ [normalizeConfigKey(args[1])]: args[2] });
        console.log(`Set ${args[1]} = ${args[1].includes('key') ? '***' : args[2]}`);
      } else if (args[0] === 'show') {
        const config = await readConfig();
        console.log(JSON.stringify(maskConfig(config), null, 2));
      } else if (args[0] === 'reset') {
        const { rm } = await import('node:fs/promises');
        await rm(getConfigDir(), { recursive: true, force: true });
        console.log('Config reset.');
      } else {
        console.log('Usage: decipher setting set <key> <value>');
        console.log('       decipher setting show');
        console.log('       decipher setting reset');
      }
      break;
    }

    case '--help':
    case '-h':
      console.log(buildHelpBanner());
      break;

    case '--version':
    case '-v':
      console.log(`decipher v${VERSION}`);
      break;

    default:
      await runInteractive();
  }
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  main().catch(err => {
    console.error(`Error: ${err.message}`);
    process.exit(3);
  });
}
