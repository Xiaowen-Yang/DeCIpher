// ── Color helpers ──────────────────────────────────────────
const C  = (s) => pc.cyan(s);
const BC = (s) => pc.bold(pc.cyan(s));
const Y  = (s) => pc.yellow(s);
const BY = (s) => pc.bold(pc.yellow(s));
const G  = (s) => pc.green(s);
const D  = (s) => pc.dim(s);
const B  = (s) => pc.bold(s);
const W  = (s) => pc.white(s);

// SLASH_COMMANDS is imported from lib/cli-surface.js (single source of truth)

// ── Banner ─────────────────────────────────────────────────
function shortenPath(p) {
  const home = homedir();
  return p.startsWith(home) ? '~' + p.slice(home.length) : p;
}

function stripAnsi(s) {
  return s.replace(/\x1b\[[0-9;]*m/g, '');
}

function truncate(s, max) {
  if (s.length <= max) return s;
  return s.slice(0, max - 3) + '...';
}

function buildSessionHeader(config, sessionState = {}) {
  const dir = shortenPath(process.cwd());
  const provider = config.provider ?? 'openai';
  const model = config.model ?? 'gpt-4o';
  const hasKey = config.api_key ? G('●') : pc.red('○');
  const approvalPolicy = sessionState.approvalPolicy ?? config.approval_policy ?? 'on-request';
  const lastState = sessionState.lastVerificationResult ?? 'idle';

  // Truncate base_url for display
  const baseUrlDisplay = config.base_url
    ? D('  (' + truncate(config.base_url, 40) + ')')
    : '';

  const lines = [
    ``,
    `    ${BY('/\\_/\\')}`,
    `   ${BY('( •ᴥ• )')}  ${BC('DeCIpher')} ${D(`v${VERSION}`)}`,
    ``,
    `  ${D('provider')}   ${C(provider)}${baseUrlDisplay}`,
    `  ${D('model')}      ${C(model)}`,
    `  ${D('directory')}  ${W(dir)}`,
    `  ${D('approval')}   ${C(approvalPolicy)}  ${D('last:')} ${D(lastState)}`,
    `  ${D('api key')}    ${hasKey} ${config.api_key ? D('configured') : pc.red('not set')}`,
    ``,
  ];

  return lines.join('\n');
}

