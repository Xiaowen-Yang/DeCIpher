#!/usr/bin/env node
// DeCIpher CLI entry point.
//
// Thin Node.js shim: non-interactive subcommands are handled here;
// the default (interactive) case execs the Rust TUI binary directly.
// The Node.js fallback interactive mode was removed in R4.

import { resolve, dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import {
  readConfig,
  writeConfig,
  maskSecret,
  normalizeConfigKey,
  canUpdateConfigKey,
  coerceConfigValue,
  getConfigDir,
} from '../lib/config.js';
import { buildCliSettingsView } from '../lib/cli-surface.js';
import { createRequire } from 'node:module';

const _require = createRequire(import.meta.url);
const { version: VERSION } = _require('../package.json');

// ── CLI subcommands ──────────────────────────────────────────
const [,, command, ...args] = process.argv;

async function main() {
  switch (command) {
    case 'config':
    case 'setting': {
      if (args[0] === 'set' && args[1] && args[2]) {
        const key = normalizeConfigKey(args[1]);
        if (!canUpdateConfigKey(key, 'setting')) {
          throw new Error(`Unsupported setting '${args[1]}'`);
        }
        const value = coerceConfigValue(key, args.slice(2).join(' '));
        const next = await writeConfig({ [key]: value });
        console.log(`Set ${key} = ${key === 'api_key' ? maskSecret(next.api_key) : value ?? '(default)'}`);
      } else if (args[0] === 'show') {
        const config = await readConfig();
        console.log(JSON.stringify(buildCliSettingsView(config, { lastRunResult: null }, null), null, 2));
      } else if (args[0] === 'reset') {
        const { rm } = await import('node:fs/promises');
        await rm(getConfigDir(), { recursive: true, force: true });
        console.log('Config reset.');
      } else {
        console.log('Usage: decipher setting set <key> <value>');
        console.log('       decipher setting show');
        console.log('       decipher setting reset');
      }
      break;
    }

    case '--help':
    case '-h':
      console.log(`
  DeCIpher v${VERSION} — mission-driven local execution agent

  Usage:  decipher [command] [args]

  Commands:
    decipher                     Interactive mode (Rust TUI)
    decipher exec <task>         Run a mission non-interactively (Rust)
    decipher setting show|set    Manage configuration
`);
      break;

    case '--version':
    case '-v':
      console.log(`decipher v${VERSION}`);
      break;

    default: {
      // Invoke Rust TUI binary directly.
      const tuiPath = await findTuiBinary();
      if (!tuiPath) {
        console.error('decipher-tui binary not found. Build with: cargo build --bin decipher-tui');
        process.exit(1);
      }
      const { spawnSync } = await import('node:child_process');
      const result = spawnSync(tuiPath, [], {
        stdio: 'inherit',
        env: {
          ...process.env,
          DECIPHER_AGENT_SCRIPT: resolve(dirname(fileURLToPath(import.meta.url)), 'decipher'),
        },
      });
      process.exit(result.status ?? 0);
    }
  }
}

async function findTuiBinary() {
  const { access } = await import('node:fs/promises');

  const binDir = dirname(fileURLToPath(import.meta.url));
  const repoRoot = join(binDir, '..');

  // Prefer release binary (faster startup, signed via `make release`).
  const releasePath = join(repoRoot, 'target', 'release', 'decipher-tui');
  try {
    await access(releasePath);
    return releasePath;
  } catch { /* not found */ }

  // Fall back to debug binary.
  const debugPath = join(repoRoot, 'target', 'debug', 'decipher-tui');
  try {
    await access(debugPath);
    return debugPath;
  } catch { /* not found */ }

  // Check next to this script (npm install location).
  const localPath = join(binDir, 'decipher-tui');
  try {
    await access(localPath);
    return localPath;
  } catch { /* not found */ }

  // Check in PATH.
  const { execSync } = await import('node:child_process');
  try {
    const p = execSync('which decipher-tui 2>/dev/null', { encoding: 'utf8' }).trim();
    if (p) return p;
  } catch { /* not in PATH */ }

  return null;
}

function flushStream(stream) {
  return new Promise((resolve) => stream.write('', resolve));
}

main()
  .catch(async (err) => {
    console.error(`Error: ${err.message}`);
    await Promise.all([flushStream(process.stdout), flushStream(process.stderr)]);
    process.exit(3);
  });
