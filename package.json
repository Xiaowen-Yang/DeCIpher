{
  "name": "decipher-cli",
  "version": "0.1.5",
  "description": "Mission-driven local execution agent for CI, Docker, and deployment tasks",
  "type": "module",
  "bin": {
    "decipher": "./bin/decipher"
  },
  "files": [
    "bin/",
    "agents/",
    "lib/",
    "prompts/",
