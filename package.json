  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiaowen-Yang/DeCIpher.git"
  },
  "homepage": "https://github.com/Xiaowen-Yang/DeCIpher#readme",
  "bugs": {
    "url": "https://github.com/Xiaowen-Yang/DeCIpher/issues"
  },
